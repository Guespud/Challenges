DATABASE_URL="postgresql://user:password@localhost:5432/vitalis_appointments?schema=public"
REDIS_URL="redis://localhost:6379"

# Debe ser el MISMO valor que JWT_ACCESS_SECRET en services/auth/.env — este
# servicio solo verifica tokens, nunca los firma.
JWT_ACCESS_SECRET="change-me"

PORT=3002
# FRONTEND_URL="https://tu-frontend.up.railway.app"

PAYMENTS_SERVICE_URL="http://localhost:3003"
# Mismo valor que INTERNAL_SERVICE_TOKEN en services/payments/.env
INTERNAL_SERVICE_TOKEN="change-me-shared-across-services"

# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"

HOLD_TTL_MINUTES=15
REMINDER_HOURS_BEFORE=24

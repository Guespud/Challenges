DATABASE_URL="postgresql://user:password@localhost:5432/vitalis_payments?schema=public"
REDIS_URL="redis://localhost:6379"

# Stripe test mode — dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# Se obtiene con `stripe listen --forward-to localhost:3003/webhooks/stripe`
STRIPE_WEBHOOK_SECRET="whsec_..."

# Secreto compartido para las rutas /internal/* — debe ser el mismo valor
# que INTERNAL_SERVICE_TOKEN en services/appointments/.env
INTERNAL_SERVICE_TOKEN="change-me-shared-across-services"

PORT=3003

# Opcional: si no se define, Sentry no se inicializa (útil en dev/test)
# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
